---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categories } from '../../data/categories';
const articles = (await getCollection('articles')).filter(a => !a.data.draft).sort((a,b) => b.data.pubDate.getTime()-a.data.pubDate.getTime());
const starterIds = [
  'gestao-clinica-na-pratica-como-organizar-a-rotina-de-um-servico-de-saude',
  'prontuario-eletronico-para-profissionais-da-saude',
  'como-usar-ia-na-clinica-sem-expor-dados-de-pacientes',
  'como-precificar-atendimentos',
  'como-construir-uma-carreira-sustentavel-na-area-da-saude',
  'fluxo-de-caixa-para-clinicas',
];
const starterArticles = starterIds.map(id => articles.find(a => a.id === id)).filter(Boolean);
---
<BaseLayout title="Blog para terapeutas: gestão, prontuário e prática clínica | TerapeutaAI" description="Blog para terapeutas e profissionais da saúde: orientações sobre gestão clínica, prontuário, IA, LGPD, carreira e desenvolvimento infantil, com fontes e autoria identificadas.">
  <script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'CollectionPage',name:'Blog para terapeutas e profissionais da saúde',description:'Artigos práticos sobre gestão clínica, prontuário, inteligência artificial, proteção de dados, carreira e cuidado.',url:'https://blog.terapeutaai.com.br/artigos/',mainEntity:{'@type':'ItemList',itemListElement:articles.map((a,i)=>({'@type':'ListItem',position:i+1,name:a.data.title,url:`https://blog.terapeutaai.com.br/artigos/${a.id}/`}))}})} />
  <section class="container archive">
    <p class="eyebrow">TerapeutaAI · conteúdos para profissionais da saúde</p>
    <h1>Blog para terapeutas: prática clínica, gestão e carreira</h1>
    <p class="lead">O TerapeutaAI reúne artigos para terapeutas e equipes de saúde que buscam organizar a rotina clínica, aprimorar registros, avaliar ferramentas digitais e desenvolver a carreira. Cada conteúdo identifica autoria e fontes para que você possa aprofundar o tema.</p>
    <nav aria-label="Escolha um tema">{categories.map(c => <a href={`/${c.slug}/`}>{c.name}</a>)}</nav>
    <section class="start" aria-labelledby="start-title">
      <h2 id="start-title">Comece por estes temas da rotina profissional</h2>
      <div class="grid featured">{starterArticles.map(a => <article>
        <a class="eyebrow" href={`/${a.data.categorySlug}/`}>{a.data.category}</a>
        <h3><a href={`/artigos/${a.id}/`}>{a.data.title}</a></h3>
        <p>{a.data.description}</p>
      </article>)}</div>
    </section>
    <h2 class="archive-title">Todos os artigos</h2>
    <p>{articles.length} artigos para consultar por assunto, com autoria e referências identificadas.</p>
    <div class="grid">{articles.map(a => <article>
      <a class="eyebrow" href={`/${a.data.categorySlug}/`}>{a.data.category}</a>
      <h3><a href={`/artigos/${a.id}/`}>{a.data.title}</a></h3>
      <p>{a.data.description}</p>
      <small>{a.data.author} · <time datetime={a.data.pubDate.toISOString()}>{a.data.pubDate.toLocaleDateString('pt-BR', {timeZone:'UTC'})}</time> · {a.data.readTime} min</small>
    </article>)}</div>
    <p class="hub">Para aplicar os conceitos à rotina, conheça o <a href="https://terapeutaai.com.br/">TerapeutaAI Hub</a> e consulte nossas <a href="/recursos/">ferramentas para a clínica</a>.</p>
    <p class="about">Conheça também <a href="/sobre/">a proposta editorial e os autores</a>.</p>
  </section>
</BaseLayout>
<style>
.archive{padding-block:64px}.archive>p{max-width:760px;color:var(--muted)}h1{font-size:clamp(2rem,5vw,3.5rem);max-width:900px;line-height:1.08}.lead{font-size:1.1rem;line-height:1.7}.archive h2{font-size:clamp(1.5rem,3vw,2rem)}nav{display:flex;flex-wrap:wrap;gap:12px;margin:30px 0}nav a{border:1px solid var(--border);border-radius:12px;padding:10px 14px;font-size:.85rem}.start{margin:54px 0}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}.grid article{padding:26px;border:1px solid var(--border);border-radius:20px}.grid h3{font-size:1.3rem;line-height:1.3;margin:14px 0}.grid h3 a{text-decoration:none}.grid p,.grid small{color:var(--muted);line-height:1.6}.featured{grid-template-columns:repeat(3,minmax(0,1fr))}.archive-title{margin-top:64px}.hub{margin-top:36px}.about{font-size:.95rem}@media(max-width:850px){.featured{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.grid,.featured{grid-template-columns:1fr}.archive{padding-block:40px}.grid article{padding:20px}}
</style>
