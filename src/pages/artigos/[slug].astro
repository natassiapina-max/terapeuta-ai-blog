---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content, headings } = await render(article);
const { data } = article;
const related = (await getCollection('articles', ({ data: itemData, id }) =>
  !itemData.draft && id !== article.id && itemData.categorySlug === data.categorySlug
)).sort((x, y) => y.data.pubDate.valueOf() - x.data.pubDate.valueOf()).slice(0, 3);

const canonical = new URL(`/artigos/${article.id}`, Astro.site ?? 'https://blog.terapeutaai.com.br').href;
const published = data.pubDate.toISOString().slice(0, 10);
const updated = data.updatedDate?.toISOString().slice(0, 10);
---

<BaseLayout
  title={`${data.title} | Terapeuta AI`}
  description={data.description}
  canonical={canonical}
  type="article"
  image={data.image}
  publishedTime={data.pubDate.toISOString()}
  modifiedTime={(data.updatedDate ?? data.pubDate).toISOString()}
>
  <article class="article-page">
    <header class="article-header container-narrow">
      <a class="article-category" href={`/${data.categorySlug}`}>{data.category}</a>
      <h1>{data.title}</h1>
      <p class="article-lead">{data.description}</p>

      <div class="article-meta">
        <span>Por {data.author}</span>
        <span>Publicado em {published.split('-').reverse().join('/')}</span>
        {updated && <span>Atualizado em {updated.split('-').reverse().join('/')}</span>}
        <span>{data.readTime} min de leitura</span>
      </div>
    </header>

    {data.image && <figure class="article-hero-image container-narrow">
      <img src={data.image} alt={data.imageAlt ?? data.title} loading="eager" />
    </figure>}

    <div class="container-narrow">
      <div class="article-summary">
        <strong>Em resumo</strong>
        <p>{data.description}</p>
      </div>
    </div>

    <nav class="article-breadcrumb container-narrow" aria-label="Breadcrumb">
      <a href="/">Início</a><span>›</span><a href={`/${data.categorySlug}`}>{data.category}</a><span>›</span><span aria-current="page">{data.title}</span>
    </nav>

    <div class="container-article article-layout">
      {headings.length > 1 && (
        <aside class="article-toc" aria-label="Neste artigo">
          <strong>Neste artigo</strong>
          <ul>
            {headings.filter((heading) => heading.depth === 2).map((heading) => (
              <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
            ))}
          </ul>
        </aside>
      )}

      <div class="prose">
        <Content />
      </div>
    </div>

    {related.length > 0 && <section class="container-narrow related">
      <div class="section-label"><span class="eyebrow">Continue explorando</span><h2>Conteúdos relacionados</h2></div>
      <div class="related-grid">
        {related.map((item) => <a class="related-card" href={`/artigos/${item.id}`}>
          <span>{item.data.category}</span>
          <h3>{item.data.title}</h3>
          <b>Ler artigo →</b>
        </a>)}
      </div>
    </section>}

    <section class="container-narrow article-footer">
      <div class="author-box">
        <div>
          <span class="eyebrow">Responsabilidade editorial</span>
          <h2>{data.author}</h2>
          {data.reviewer && <p>Revisão: {data.reviewer}</p>}
        </div>
      </div>

      {data.sources?.length > 0 && <section class="sources">
        <span class="eyebrow">Fontes e referências</span>
        <h2>Para aprofundar</h2>
        <ul>
          {data.sources.map((source) => <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.label} ↗</a></li>)}
        </ul>
      </section>}

      <div class="article-cta">
        <span class="eyebrow">Terapeuta AI</span>
        <h2>Mais conhecimento para uma rotina profissional mais organizada.</h2>
        <p>Explore outros conteúdos sobre tecnologia, gestão, documentação, carreira e ética.</p>
        <a class="btn btn-primary" href={`/${data.categorySlug}`}>Continuar lendo</a>
      </div>
    </section>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: data.title,
    description: data.description,
    datePublished: data.pubDate.toISOString(),
    dateModified: (data.updatedDate ?? data.pubDate).toISOString(),
    author: {
      '@type': 'Organization',
      name: data.author,
      url: 'https://blog.terapeutaai.com.br/sobre'
    },
    publisher: {
      '@type': 'Organization',
      name: 'Terapeuta AI',
      url: 'https://terapeutaai.com.br',
      logo: { '@type': 'ImageObject', url: 'https://blog.terapeutaai.com.br/images/logomarca-terapeuta-ai-2-.png' }
    },
    image: data.image ? [new URL(data.image, 'https://blog.terapeutaai.com.br').href] : undefined,
    mainEntityOfPage: canonical,
    inLanguage: 'pt-BR',
    articleSection: data.category,
    keywords: data.tags
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: 'https://blog.terapeutaai.com.br/' },
      { '@type': 'ListItem', position: 2, name: data.category, item: new URL('/' + data.categorySlug, 'https://blog.terapeutaai.com.br').href },
      { '@type': 'ListItem', position: 3, name: data.title, item: canonical }
    ]
  })} />
</BaseLayout>

<style>
.article-page { padding: 76px 0 0; }
.article-breadcrumb{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:34px;color:var(--muted);font-size:.72rem}.article-breadcrumb a{text-decoration:none;color:var(--purple)}.article-breadcrumb span:last-child{max-width:480px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.container-narrow { width: min(calc(100% - 40px), 900px); margin-inline: auto; }
.container-article { width: min(calc(100% - 40px), 1180px); margin-inline: auto; }

.article-header h1 { max-width: 920px; }
.article-category {
  display:inline-block;
  margin-bottom:18px;
  color:var(--purple);
  font-size:.82rem;
  font-weight:700;
  text-decoration:none;
}
.article-lead {
  max-width:820px;
  margin:24px 0;
  font-size:1.2rem;
  color:var(--text-soft);
}
.article-meta {
  display:flex;
  flex-wrap:wrap;
  gap:10px 20px;
  color:var(--text-soft);
  font-size:.82rem;
}
.article-summary {
  margin:42px 0;
  padding:28px;
  border:1px solid var(--border);
  border-radius:20px;
  background:var(--surface-soft);
}
.article-summary p { margin:8px 0 0; }
.article-hero-image { margin-top:38px; margin-bottom:10px; }
.article-hero-image img { display:block; width:100%; max-height:520px; object-fit:cover; border-radius:24px; border:1px solid var(--border); box-shadow:var(--shadow); }
.sources { margin-top:54px; padding-top:30px; border-top:1px solid var(--border); }
.sources h2 { font-size:1.45rem; margin:0 0 12px; }
.sources ul { margin:0; padding-left:20px; }
.sources li { margin:8px 0; }
.sources a { color:var(--violet); text-decoration:none; font-size:.9rem; }
.article-layout {
  display:grid;
  grid-template-columns:240px minmax(0, 760px);
  gap:64px;
  align-items:start;
}
.article-toc {
  position:sticky;
  top:104px;
  padding:22px;
  border:1px solid var(--border);
  border-radius:18px;
  background:white;
}
.article-toc ul { padding-left:18px; margin-bottom:0; }
.article-toc li { margin:10px 0; }
.article-toc a { color:var(--text-soft); text-decoration:none; font-size:.85rem; }

.prose {
  font-size:1.05rem;
}
.prose h2 {
  margin-top:52px;
  margin-bottom:18px;
  font-size:clamp(1.65rem, 3vw, 2.25rem);
}
.prose p, .prose li { color:var(--text-soft); }
.prose li { margin:8px 0; }
.prose blockquote {
  margin:42px 0;
  padding:26px 28px;
  border-left:4px solid var(--purple);
  border-radius:0 16px 16px 0;
  background:var(--surface-soft);
  color:var(--deep);
  font-weight:600;
}

.related{padding-top:70px}.section-label h2{font-size:1.8rem;margin:0 0 20px}.related-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.related-card{min-height:190px;padding:24px;border:1px solid var(--border);border-radius:20px;background:var(--soft);text-decoration:none;display:flex;flex-direction:column}.related-card>span{color:var(--purple);font-size:.64rem;font-weight:700;text-transform:uppercase;letter-spacing:.1em}.related-card h3{margin:12px 0;font-size:1.15rem;color:var(--deep)}.related-card b{margin-top:auto;color:var(--violet);font-size:.75rem}.article-footer { padding:70px 0 10px; }
.author-box {
  padding:26px;
  border:1px solid var(--border);
  border-radius:20px;
  background:white;
}
.author-box h2 { margin:4px 0 8px; font-size:1.4rem; }
.author-box p { margin:0; color:var(--text-soft); }
.article-cta {
  margin-top:24px;
  padding:34px;
  border-radius:24px;
  background:linear-gradient(135deg,var(--purple),var(--violet));
  color:white;
}
.article-cta h2 { margin:4px 0 10px; color:white; }
.article-cta p { color:#eadfff; }

@media (max-width: 900px) {
  .article-layout { grid-template-columns:1fr; gap:28px; }
  .article-toc { position:static; }
}
@media (max-width: 720px) {
  .related-grid{grid-template-columns:1fr}
  .article-page { padding-top:54px; }
  .container-narrow, .container-article { width:min(calc(100% - 28px), 900px); }
}
</style>
