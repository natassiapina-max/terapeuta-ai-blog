---
import { getCollection, render } from 'astro:content';
import { imageDimensions } from '../../utils/imageDimensions';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const articles = (await getCollection('articles')).filter((article) => article.data?.draft !== true);
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content, headings } = await render(article);
const { data } = article;
const publishedArticles = (await getCollection('articles', ({ data: itemData, id }) =>
  !itemData.draft && id !== article.id
)).sort((x, y) => (y.data.pubDate?.getTime?.() ?? 0) - (x.data.pubDate?.getTime?.() ?? 0));
const related = publishedArticles
  .filter((item) => item.data.categorySlug === data.categorySlug)
  .slice(0, 3);
const nextArticle = related[0] ?? publishedArticles[0];

const canonical = new URL(`/artigos/${article.id}/`, Astro.site ?? 'https://blog.terapeutaai.com.br').href;
const published = data.pubDate.toISOString().slice(0, 10);
const updated = data.updatedDate?.toISOString().slice(0, 10);
const summaryText = data.directAnswer ?? data.description;
const extractFaqItems = (body: string) => {
  const faqStart = body.search(/^## (Perguntas frequentes|FAQ)/m);
  if (faqStart === -1) return [];
  const faqBody = body.slice(faqStart).replace(/^## (Perguntas frequentes|FAQ)[^\n]*\n?/m, '');
  const nextSection = faqBody.search(/^## (?!#)/m);
  const section = nextSection === -1 ? faqBody : faqBody.slice(0, nextSection);
  const matches = [...section.matchAll(/(?:^|\n)###\s+(.+)\n([\s\S]*?)(?=\n###\s+|\n##\s+|$)/g)];
  return matches
    .map((match) => ({
      question: match[1].trim(),
      answer: match[2]
        .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '$1')
        .replace(/[*_`>#-]/g, '')
        .replace(/\s+/g, ' ')
        .trim()
    }))
    .filter((item) => item.question && item.answer)
    .slice(0, 8);
};
// Structured answers come from the questions actually visible in the article.
const faqItems = extractFaqItems(article.body ?? '');
const authorProfile = data.author === 'Juliano Lima'
  ? {
      name: 'Juliano Lima',
      role: 'Musicoterapeuta, escritor e fundador do TerapeutaAI Hub.',
      credentials: 'Administrador, musicoterapeuta (ABMT 182-PR), pós-graduado em ABA e TEA, coautor do livro Conexão Autista.',
      bio: 'Atua desde 2019 com saúde mental, neurodesenvolvimento, TEA, TDAH e tecnologia aplicada à rotina clínica. É criador do Terapeuta AI Hub e escreve sobre gestão, ética, carreira e inovação para profissionais da saúde.',
      image: '/images/foto-rosto-juliano-lima.webp',
      url: 'https://blog.terapeutaai.com.br/autores/juliano-lima/',
      sameAs: [
        'https://www.linkedin.com/in/julianolimamt/',
        'https://www.instagram.com/julianolima.mt/',
        'https://terapeutaai.com.br'
      ],
      links: [
        { label: 'Instagram', url: 'https://www.instagram.com/julianolima.mt/' },
        { label: 'LinkedIn', url: 'https://www.linkedin.com/in/julianolimamt/' },
        { label: 'TerapeutaAI Hub', url: 'https://terapeutaai.com.br' }
      ]
    }
  : null;
---

<BaseLayout
  title={`${data.seoTitle ?? data.title} | TerapeutaAI`}
  description={data.description}
  canonical={canonical}
  type="article"
  image={data.image}
  publishedTime={data.pubDate.toISOString()}
  modifiedTime={(data.updatedDate ?? data.pubDate).toISOString()}
>
  <article class="article-page">
    <header class="article-header container-narrow">
      <a class="article-category" href={`/${data.categorySlug}/`}>{data.category}</a>
      <h1>{data.title}</h1>
      <p class="article-lead">{data.description}</p>

      <div class="article-meta">
        <span>Por {authorProfile ? <a href={authorProfile.url}>{data.author}</a> : data.author}</span>
        <span>Publicado em {published.split('-').reverse().join('/')}</span>
        {updated && <span>Atualizado em {updated.split('-').reverse().join('/')}</span>}
        <span>{data.readTime} min de leitura</span>
      </div>
      {data.directAnswer && <p class="direct-answer"><strong>Resposta direta:</strong> {data.directAnswer}</p>}
    </header>

    {data.image && <figure class="article-hero-image container-narrow">
      <img src={data.image} {...imageDimensions(data.image)} alt={data.imageAlt ?? data.title} loading="eager" fetchpriority="high" decoding="async" />
    </figure>}



    <nav class="article-breadcrumb container-narrow" aria-label="Breadcrumb">
      <a href="/">Início</a><span>›</span><a href={`/${data.categorySlug}/`}>{data.category}</a><span>›</span><span aria-current="page">{data.title}</span>
    </nav>

    <div class="container-article article-layout">
      {headings.length > 1 && (
        <aside class="article-toc" aria-label="Neste artigo">
          <strong>Neste artigo</strong>
          <ul>
            {headings.filter((heading) => heading.depth === 2).map((heading) => (
              <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
            ))}
          </ul>
        </aside>
      )}

      <div class="prose">
        <Content />
      </div>
    </div>

    {related.length > 0 && <section class="container-narrow related">
      <div class="section-label"><span class="eyebrow">Continue explorando</span><h2>Conteúdos relacionados</h2></div>
      <div class="related-grid">
        {related.map((item) => <a class="related-card" href={`/artigos/${item.id}/`}>
          <span>{item.data.category}</span>
          <h3>{item.data.title}</h3>
          <b>Ler artigo →</b>
        </a>)}
      </div>
    </section>}

    <section class="container-narrow article-footer">
      <div class="author-box">
        {authorProfile && (
          <img width="320" height="320" class="author-photo" src={authorProfile.image} alt={`Foto de ${authorProfile.name}`} loading="lazy" />
        )}
        <div>
          <span class="eyebrow">Responsabilidade editorial</span>
          {authorProfile ? <h2><a href={authorProfile.url}>{data.author}</a></h2> : <h2>{data.author}</h2>}
          {authorProfile && <strong>{authorProfile.role}</strong>}
          {authorProfile && <p class="author-credentials">{authorProfile.credentials}</p>}
          {authorProfile && <p>{authorProfile.bio}</p>}
          {authorProfile?.links && (
            <div class="author-links">
              {authorProfile.links.map((link) => <a href={link.url} target="_blank" rel="noopener noreferrer">{link.label}</a>)}
            </div>
          )}
          {data.reviewer && <p>Revisão: {data.reviewer}</p>}
        </div>
      </div>

      {data.sources?.length > 0 && <section class="sources">
        <span class="eyebrow">Fontes e referências</span>
        <h2>Para aprofundar</h2>
        <ul>
          {data.sources.map((source) => <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.label} ↗</a></li>)}
        </ul>
      </section>}

      <div class="article-cta">
        <span class="eyebrow">Terapeuta AI</span>
        <h2>Organize sua rotina clínica com mais clareza.</h2>
        <p>O TerapeutaAI Hub reúne agenda, prontuário, gestão financeira e recursos de inteligência artificial para apoiar profissionais e clínicas na rotina de cuidado.</p>
        <p class="commercial-disclosure">Este blog é mantido pelo TerapeutaAI. Juliano Lima é fundador do Hub, produto apresentado neste espaço.</p>
        <div class="cta-actions">
          <a class="btn btn-primary" href="https://terapeutaai.com.br" target="_blank" rel="noreferrer">Conheça o TerapeutaAI Hub</a>
          {nextArticle && <a class="btn btn-secondary" href={`/artigos/${nextArticle.id}/`}>Continuar lendo</a>}
        </div>
      </div>
    </section>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: data.title,
    description: data.description,
    abstract: summaryText,
    datePublished: data.pubDate.toISOString(),
    dateModified: (data.updatedDate ?? data.pubDate).toISOString(),
    author: {
      '@type': data.author === 'Juliano Lima' ? 'Person' : 'Organization',
      '@id': authorProfile ? authorProfile.url + '#person' : undefined,
      name: data.author,
      url: authorProfile?.url ?? 'https://blog.terapeutaai.com.br/sobre',
      image: authorProfile ? new URL(authorProfile.image, 'https://blog.terapeutaai.com.br').href : undefined,
      jobTitle: authorProfile ? 'Musicoterapeuta, escritor e fundador do TerapeutaAI Hub' : undefined,
      description: authorProfile ? `${authorProfile.credentials} ${authorProfile.bio}` : undefined,
      sameAs: authorProfile?.sameAs,
      knowsAbout: authorProfile ? [
        'Musicoterapia',
        'ABA',
        'TEA',
        'TDAH',
        'Saúde mental',
        'Neurodesenvolvimento',
        'Conexão Autista',
        'TerapeutaAI Hub',
        'Tecnologia para profissionais da saúde'
      ] : undefined
    },
    reviewedBy: data.reviewer ? {
      '@type': 'Person',
      name: data.reviewer,
      url: data.reviewerUrl ?? (data.reviewer === data.author ? authorProfile?.url : undefined)
    } : undefined,
    citation: data.sources?.map((source) => ({
      '@type': 'CreativeWork',
      name: source.label,
      url: source.url
    })),
    about: data.tags,
    publisher: {
      '@type': 'Organization',
      name: 'Terapeuta AI',
      url: 'https://terapeutaai.com.br',
      logo: { '@type': 'ImageObject', url: 'https://blog.terapeutaai.com.br/images/logomarca-terapeuta-ai-2-.png' }
    },
    image: data.image ? [new URL(data.image, 'https://blog.terapeutaai.com.br').href] : undefined,
    mainEntityOfPage: canonical,
    inLanguage: 'pt-BR',
    articleSection: data.category,
    keywords: data.tags
  })} />
  {faqItems.length > 0 && (
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqItems.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.answer
        }
      }))
    })} />
  )}
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: 'https://blog.terapeutaai.com.br/' },
      { '@type': 'ListItem', position: 2, name: data.category, item: new URL('/' + data.categorySlug + '/', 'https://blog.terapeutaai.com.br').href },
      { '@type': 'ListItem', position: 3, name: data.title, item: canonical }
    ]
  })} />
</BaseLayout>

<style>
.article-page { padding: 76px 0 0; }
.article-breadcrumb{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:34px;color:var(--muted);font-size:.72rem}.article-breadcrumb a{text-decoration:none;color:var(--purple)}.article-breadcrumb span:last-child{max-width:480px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.container-narrow { width: min(calc(100% - 40px), 900px); margin-inline: auto; }
.container-article { width: min(calc(100% - 40px), 1180px); margin-inline: auto; }

.article-header h1 { max-width: 920px; font-size:clamp(2rem,4.4vw,3.25rem); line-height:1.16; }
.article-category {
  display:inline-block;
  margin-bottom:18px;
  color:var(--purple);
  font-size:.82rem;
  font-weight:700;
  text-decoration:none;
}
.article-lead {
  max-width:820px;
  margin:24px 0;
  font-size:1.2rem;
  color:var(--text-soft);
}
.article-meta {
  display:flex;
  flex-wrap:wrap;
  gap:10px 20px;
  color:var(--text-soft);
  font-size:.82rem;
}
.direct-answer {
  max-width:820px;
  margin:24px 0 0;
  padding:18px 20px;
  border-left:4px solid var(--purple);
  border-radius:0 14px 14px 0;
  background:var(--surface-soft);
  color:var(--deep);
  font-size:1rem;
}
.article-summary {
  margin:42px 0;
  padding:28px;
  border:1px solid var(--border);
  border-radius:20px;
  background:var(--surface-soft);
}
.article-summary p { margin:8px 0 0; }
.article-hero-image { margin-top:38px; margin-bottom:10px; }
.article-hero-image img {
  display:block;
  width:100%;
  max-height:520px;
  object-fit:contain;
  background:var(--surface-soft);
  border-radius:24px;
  border:1px solid var(--border);
  box-shadow:var(--shadow);
}
.sources { margin-top:54px; padding-top:30px; border-top:1px solid var(--border); }
.sources h2 { font-size:1.45rem; margin:0 0 12px; }
.sources ul { margin:0; padding-left:20px; }
.sources li { margin:8px 0; }
.sources a { color:var(--violet); text-decoration:none; font-size:.9rem; }
.article-layout {
  display:grid;
  grid-template-columns:240px minmax(0, 760px);
  gap:64px;
  align-items:start;
}
.article-toc {
  position:sticky;
  top:104px;
  padding:22px;
  border:1px solid var(--border);
  border-radius:18px;
  background:white;
}
.article-toc ul { padding-left:18px; margin-bottom:0; }
.article-toc li { margin:10px 0; }
.article-toc a { color:var(--text-soft); text-decoration:none; font-size:.85rem; }

.prose {
  font-size:1.05rem;
}
.prose h2 {
  margin-top:52px;
  margin-bottom:18px;
  font-size:clamp(1.65rem, 3vw, 2.25rem);
}
.prose p, .prose li { color:var(--text-soft); }
.prose li { margin:8px 0; }
.prose table { display:block; width:100%; max-width:100%; overflow-x:auto; border-collapse:collapse; -webkit-overflow-scrolling:touch; }
.prose th, .prose td { min-width:140px; padding:10px 12px; border:1px solid var(--border); text-align:left; vertical-align:top; }
.prose blockquote {
  margin:42px 0;
  padding:26px 28px;
  border-left:4px solid var(--purple);
  border-radius:0 16px 16px 0;
  background:var(--surface-soft);
  color:var(--deep);
  font-weight:600;
}

.related{padding-top:70px}.section-label h2{font-size:1.8rem;margin:0 0 20px}.related-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.related-card{min-height:190px;padding:24px;border:1px solid var(--border);border-radius:20px;background:var(--soft);text-decoration:none;display:flex;flex-direction:column}.related-card>span{color:var(--purple);font-size:.64rem;font-weight:700;text-transform:uppercase;letter-spacing:.1em}.related-card h3{margin:12px 0;font-size:1.15rem;color:var(--deep)}.related-card b{margin-top:auto;color:var(--violet);font-size:.75rem}.article-footer { padding:70px 0 10px; }
.author-box {
  display:flex;
  gap:22px;
  align-items:center;
  padding:26px;
  border:1px solid var(--border);
  border-radius:20px;
  background:white;
}
.author-photo {
  width:96px;
  height:96px;
  flex:0 0 96px;
  border-radius:50%;
  object-fit:cover;
  border:1px solid var(--border);
  box-shadow:0 12px 28px rgba(94,38,214,.12);
}
.author-box h2 { margin:4px 0 8px; font-size:1.4rem; }
.author-box h2 a { color:inherit; text-decoration:none; }
.author-box strong { display:block; margin-bottom:8px; color:var(--deep); font-size:.9rem; }
.author-box p { margin:0; color:var(--text-soft); font-size:.92rem; }
.author-box .author-credentials { margin-bottom:8px; color:var(--deep); font-weight:600; }
.author-links { display:flex; flex-wrap:wrap; gap:10px; margin-top:12px; }
.author-links a { color:var(--purple); font-size:.82rem; font-weight:700; text-decoration:none; }
.article-cta {
  margin-top:24px;
  padding:34px;
  border-radius:24px;
  background:linear-gradient(135deg,var(--purple),var(--violet));
  color:white;
}
.article-cta h2 { margin:4px 0 10px; color:white; }
.article-cta p { color:#eadfff; }
.cta-actions { display:flex; flex-wrap:wrap; gap:12px; margin-top:18px; }
.article-cta .btn-secondary { color:white; border-color:rgba(255,255,255,.42); background:rgba(255,255,255,.08); }

@media (max-width: 900px) {
  .article-layout { grid-template-columns:1fr; gap:28px; }
  .article-toc { position:static; }
}
@media (max-width: 720px) {
  .related-grid{grid-template-columns:1fr}
  .article-page { padding-top:54px; min-width:0; max-width:100%; }
  .container-narrow, .container-article { width:min(calc(100% - 28px), 900px); min-width:0; max-width:100%; }
  .article-header, .article-summary, .article-breadcrumb, .article-layout, .article-footer { min-width:0; max-width:100%; }
  .prose { min-width:0; max-width:100%; overflow-wrap:anywhere; }
  .prose > * { max-width:100%; }
  .prose pre { max-width:100%; overflow-x:auto; }
  .prose img, .prose iframe, .prose video { max-width:100%; }
  .author-box { align-items:flex-start; }
}
@media (max-width: 560px) {
  .author-box { flex-direction:column; }
}
</style>

