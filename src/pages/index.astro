---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { categories } from '../data/categories';

const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featured = articles.find((article) => article.data.featured) ?? articles[0];
const latest = articles.filter((article) => article.id !== featured?.id).slice(0, 4);
---

<BaseLayout
  title="Terapeuta AI — Conhecimento para quem cuida de pessoas"
  description="Conteúdos sobre inteligência artificial, gestão clínica, prontuário, carreira, marketing, ética e tecnologia para profissionais da saúde e das terapias."
>
  <section class="home-hero">
    <div class="container">
      <p class="eyebrow">Blog Terapeuta AI</p>
      <h1>Conhecimento para quem cuida de pessoas.</h1>
      <p class="hero-copy">
        Conteúdos práticos sobre tecnologia, inteligência artificial, gestão clínica,
        carreira e rotina profissional para quem trabalha na saúde e nas terapias.
      </p>
      <a class="btn btn-primary" href="#conteudos">Explorar conteúdos</a>
    </div>
  </section>

  {featured && (
    <section class="container featured-section" id="conteudos">
      <div class="section-label">
        <p class="eyebrow">Em destaque</p>
        <span>Leitura recomendada</span>
      </div>

      <article class="featured-card">
        <div>
          <a class="card-category" href={`/${featured.data.categorySlug}`}>{featured.data.category}</a>
          <h2>{featured.data.title}</h2>
          <p>{featured.data.description}</p>
          <div class="card-meta">{featured.data.readTime} min de leitura · Por {featured.data.author}</div>
        </div>
        <a class="btn btn-primary" href={`/artigos/${featured.id}`}>Ler artigo</a>
      </article>
    </section>
  )}

  <section class="container section-block">
    <div class="section-label">
      <p class="eyebrow">Explore por tema</p>
      <span>Conteúdo organizado por contexto</span>
    </div>
    <div class="category-grid">
      {categories.map((category) => (
        <a class="category-card" href={`/${category.slug}`}>
          <span class="category-dot" aria-hidden="true"></span>
          <h3>{category.name}</h3>
          <p>{category.description}</p>
        </a>
      ))}
    </div>
  </section>

  {latest.length > 0 && (
    <section class="container section-block">
      <div class="section-label">
        <p class="eyebrow">Mais recentes</p>
        <span>Novos conteúdos</span>
      </div>
      <div class="latest-grid">
        {latest.map((article) => (
          <article class="latest-card">
            <a class="card-category" href={`/${article.data.categorySlug}`}>{article.data.category}</a>
            <h3>{article.data.title}</h3>
            <p>{article.data.description}</p>
            <a class="read-link" href={`/artigos/${article.id}`}>Ler artigo →</a>
          </article>
        ))}
      </div>
    </section>
  )}

  <section class="container purpose-section">
    <div>
      <p class="eyebrow">O propósito</p>
      <h2>Tecnologia com contexto profissional.</h2>
    </div>
    <p>
      Informação clara, fontes confiáveis e aplicação prática para quem cuida de pessoas.
      O blog existe para transformar temas complexos em conhecimento útil para a rotina.
    </p>
  </section>
</BaseLayout>

<style>
.home-hero {
  padding:104px 0 92px;
  background:linear-gradient(180deg,#faf7ff 0%,#fff 100%);
}
.home-hero h1 { max-width:900px; }
.hero-copy {
  max-width:760px;
  margin:28px 0 34px;
  color:var(--text-soft);
  font-size:1.12rem;
}
.featured-section { padding:70px 0 20px; }
.section-block { padding:54px 0; }
.section-label {
  display:flex;
  align-items:end;
  justify-content:space-between;
  gap:20px;
  margin-bottom:24px;
}
.section-label span { color:var(--text-soft); font-size:.82rem; }
.featured-card {
  display:flex;
  align-items:end;
  justify-content:space-between;
  gap:36px;
  padding:42px;
  border:1px solid var(--border);
  border-radius:26px;
  background:white;
  box-shadow:0 18px 50px rgba(94,38,214,.08);
}
.featured-card h2 { max-width:760px; margin:8px 0 16px; }
.featured-card p { max-width:780px; color:var(--text-soft); }
.card-category {
  color:var(--purple);
  font-size:.78rem;
  font-weight:700;
  text-decoration:none;
  text-transform:uppercase;
  letter-spacing:.08em;
}
.card-meta { color:var(--text-soft); font-size:.8rem; margin-top:20px; }
.category-grid {
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:18px;
}
.category-card {
  position:relative;
  padding:28px;
  min-height:190px;
  border:1px solid var(--border);
  border-radius:20px;
  background:var(--surface-soft);
  text-decoration:none;
  transition:transform .2s ease, box-shadow .2s ease;
}
.category-card:hover {
  transform:translateY(-3px);
  box-shadow:0 14px 34px rgba(94,38,214,.08);
}
.category-dot {
  display:block;
  width:10px;
  height:10px;
  margin-bottom:22px;
  border-radius:999px;
  background:linear-gradient(135deg,var(--purple),var(--violet));
}
.category-card h3 { margin:0 0 10px; color:var(--deep); }
.category-card p { margin:0; color:var(--text-soft); font-size:.9rem; }
.latest-grid {
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:18px;
}
.latest-card {
  padding:28px;
  border:1px solid var(--border);
  border-radius:20px;
  background:white;
}
.latest-card h3 { margin:8px 0 12px; }
.latest-card p { color:var(--text-soft); }
.read-link { color:var(--violet); font-weight:700; text-decoration:none; }
.purpose-section {
  margin-top:42px;
  margin-bottom:30px;
  padding:40px;
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:50px;
  border-radius:24px;
  background:var(--deep);
  color:white;
}
.purpose-section h2 { margin:0; color:white; }
.purpose-section > p { margin:0; color:#eadfff; }

@media (max-width:820px) {
  .category-grid, .latest-grid { grid-template-columns:1fr 1fr; }
  .featured-card { align-items:start; flex-direction:column; }
  .purpose-section { grid-template-columns:1fr; gap:20px; }
}
@media (max-width:560px) {
  .home-hero { padding:76px 0 70px; }
  .section-label { align-items:start; flex-direction:column; gap:4px; }
  .category-grid, .latest-grid { grid-template-columns:1fr; }
  .featured-card { padding:28px; }
  .purpose-section { padding:30px; }
}
</style>
