---
import { getCollection } from 'astro:content';
import { imageDimensions } from '../utils/imageDimensions';
import BaseLayout from '../layouts/BaseLayout.astro';
import { categories } from '../data/categories';

const articles = (await getCollection('articles')).filter((article) => article.data?.draft !== true)
  .sort((a,b) => (b.data.pubDate?.getTime?.() ?? 0) - (a.data.pubDate?.getTime?.() ?? 0));
const featured = articles.find(a => a.data.featured) ?? articles[0];
const featuredImageDimensions = imageDimensions(featured?.data.image);
const latest = articles.filter(a => a.id !== featured?.id).slice(0,4);
---
<BaseLayout title="TerapeutaAI — Conhecimento para quem cuida de pessoas" description="Conteúdos sobre inteligência artificial, gestão clínica, prontuário, carreira, marketing, ética e tecnologia para profissionais da saúde e das terapias." image="/images/blog-social-og.png" imageAlt="Imagem social do Blog TerapeutaAI: Conhecimento para quem cuida de pessoas">
  <section class="hub-banner" aria-labelledby="hub-banner-title">
    <div class="container">
      <div class="hub-banner-card">
        <div class="hub-banner-copy">
          <p class="hub-banner-kicker"><span aria-hidden="true">✦</span> Conheça o TerapeutaAI HUB</p>
          <h2 id="hub-banner-title">Sua clínica organizada para você cuidar do que importa.</h2>
          <p>Agenda, equipe, prontuário e gestão em um só lugar. Conheça o TerapeutaAI HUB e veja como simplificar a rotina da sua clínica.</p>
          <a class="hub-banner-cta" href="https://terapeutaai.com.br" target="_blank" rel="noreferrer">Conheça o TerapeutaAI HUB <span aria-hidden="true">↗</span></a>
          <div class="hub-banner-features" aria-label="Recursos do sistema">Agenda <i>•</i> Equipe <i>•</i> Prontuário <i>•</i> Gestão</div>
        </div>
        <div class="hub-banner-visual">
          <img src="/images/home-terapeuta-ai-hero.webp" alt="Terapeuta organizando a rotina da clínica em um tablet, em um espaço de atendimento acolhedor" width="1000" height="728" fetchpriority="high" decoding="async" />
          <span class="hub-banner-badge"><b aria-hidden="true">✦</b> Mais clareza na rotina clínica</span>
        </div>
      </div>
    </div>
  </section>

  <section class="hero">
    <div class="hero-glow glow-one"></div><div class="hero-glow glow-two"></div>
    <div class="container hero-grid">
      <div class="hero-copy">
        <div class="kicker"><span></span> Blog TerapeutaAI</div>
        <h1>Conhecimento para quem <em>cuida</em> de pessoas.</h1>
        <p>Conteúdo confiável para transformar tecnologia, gestão e conhecimento em decisões melhores na rotina profissional.</p>
        <div class="actions"><a class="btn btn-primary" href="#conteudos">Explorar conteúdos <span>↓</span></a><a class="hero-link" href="#temas">Explorar por tema <span>→</span></a></div>
      </div>
    </div>
    <div class="topic-bar"><div class="container topic-inner"><span>Inteligência Artificial</span><i>•</i><span>Gestão Clínica</span><i>•</i><span>Prontuário</span><i>•</i><span>Marketing</span><i>•</i><span>Carreira</span><i>•</i><span>Ética & LGPD</span></div></div>
  </section>

  {featured && <section class="container featured" id="conteudos">
    <div class="section-head"><div><p class="eyebrow">Leitura em destaque</p><h2>Comece por aqui.</h2></div><p>Um conteúdo escolhido para abrir a conversa.</p></div>
    <article class="featured-card">
      <div class={`featured-art ${featured.data.image ? 'featured-art--image' : ''}`} aria-hidden={featured.data.image ? undefined : 'true'} style={featuredImageDimensions.width && featuredImageDimensions.height ? `--featured-image-ratio: ${featuredImageDimensions.width} / ${featuredImageDimensions.height}` : undefined}>
        {featured.data.image ? <img {...imageDimensions(featured.data.image)} src={featured.data.image} alt={featured.data.imageAlt ?? featured.data.title} loading="lazy" decoding="async" /> : <><span>TERAPEUTA AI</span><strong>CONHECIMENTO<br/>QUE SE APLICA.</strong><div class="art-line"></div></>}
      </div>
      <div class="featured-content">
        <a class="category" href={`/${featured.data.categorySlug}/`}>{featured.data.category}</a>
        <h3>{featured.data.title}</h3><p>{featured.data.description}</p>
        <div class="meta"><span>{featured.data.readTime} min de leitura</span><span>Por {featured.data.author}</span></div>
        <a class="read-link" href={`/artigos/${featured.id}/`}>Ler artigo <span>→</span></a>
      </div>
    </article>
  </section>}

  <section class="container themes" id="temas">
    <div class="section-head"><div><p class="eyebrow">Explore por tema</p><h2>Escolha o assunto que acompanha sua rotina.</h2></div><p>Conteúdo organizado para facilitar a descoberta.</p></div>
    <div class="theme-grid">
      {categories.map((category,index) => <a class="theme-card" href={`/${category.slug}/`}>
        <div class="theme-top"><span>0{index+1}</span><b>↗</b></div>
        <div class="theme-icon">{['✺','♡','✦','◫','▤','◎','↗','◇'][index]}</div>
        <h3>{category.name}</h3><p>{category.description}</p>
      </a>)}
    </div>
  </section>

  {latest.length > 0 && <section class="container latest">
    <div class="section-head"><div><p class="eyebrow">Mais recentes</p><h2>Para continuar pensando.</h2></div><p><a href="/artigos/">Ver todos os {articles.length} artigos →</a></p></div>
    <div class="latest-grid">{latest.map(article => <article class="latest-card">
      <div class="latest-meta"><a class="category" href={`/${article.data.categorySlug}/`}>{article.data.category}</a><span>{article.data.readTime} min</span></div>
      <h3>{article.data.title}</h3><p>{article.data.description}</p>
      <a class="read-link" href={`/artigos/${article.id}/`}>Ler artigo <span>→</span></a>
    </article>)}</div>
  </section>}

  <section class="container manifesto">
    <div class="manifesto-mark">+</div>
    <div><p class="eyebrow">Nosso propósito</p><h2>Tecnologia com contexto. Conhecimento com propósito.</h2><p>O Blog TerapeutaAI aproxima informação, prática profissional e tecnologia — sem transformar assuntos complexos em respostas rasas.</p></div>
  </section>
</BaseLayout>

<style>
.hub-banner{position:relative;z-index:4;padding:22px 0 0;background:linear-gradient(180deg,#fff 0%,#fbf8ff 100%)}
.hub-banner-card{display:grid;grid-template-columns:1.05fr .95fr;align-items:center;gap:35px;min-height:310px;padding:24px 28px 24px 44px;overflow:hidden;border:1px solid rgba(146,47,208,.16);border-radius:28px;background:linear-gradient(115deg,#f7f0ff 0%,#fff 53%,#f0e7ff 100%);box-shadow:0 20px 55px rgba(94,38,214,.10)}
.hub-banner-copy{padding:10px 0}
.hub-banner-kicker{display:flex;align-items:center;gap:9px;margin:0 0 13px;color:var(--purple);font-size:.7rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase}
.hub-banner-kicker span{display:grid;place-items:center;width:25px;height:25px;border-radius:8px;background:#eadcff;font-size:.9rem}
.hub-banner-copy h2{max-width:620px;margin:0;color:var(--deep);font-size:clamp(1.75rem,3.1vw,2.65rem);line-height:1.12;letter-spacing:-.045em}
.hub-banner-copy>p:not(.hub-banner-kicker){max-width:590px;margin:14px 0 20px;color:var(--muted);font-size:.92rem;line-height:1.7}
.hub-banner-cta{display:inline-flex;align-items:center;gap:10px;min-height:47px;padding:0 19px;border-radius:13px;background:linear-gradient(135deg,var(--purple),var(--violet));color:#fff;font-size:.78rem;font-weight:700;text-decoration:none;box-shadow:0 10px 24px rgba(94,38,214,.2);transition:transform .2s,box-shadow .2s}
.hub-banner-cta:hover{transform:translateY(-2px);box-shadow:0 14px 28px rgba(94,38,214,.25)}
.hub-banner-cta span{font-size:1rem}
.hub-banner-features{display:flex;flex-wrap:wrap;gap:8px;margin-top:16px;color:var(--muted);font-size:.65rem;font-weight:600}
.hub-banner-features i{font-style:normal;color:var(--purple)}
.hub-banner-visual{position:relative;align-self:stretch;min-height:260px;overflow:hidden;border-radius:21px;background:#eee4fb;box-shadow:0 15px 38px rgba(42,18,114,.14)}
.hub-banner-visual img{display:block;width:100%;height:100%;min-height:260px;object-fit:cover;object-position:center 42%}
.hub-banner-badge{position:absolute;right:15px;bottom:15px;display:flex;align-items:center;gap:8px;padding:10px 13px;border:1px solid rgba(255,255,255,.72);border-radius:12px;background:rgba(255,255,255,.92);color:var(--deep);font-size:.66rem;font-weight:700;box-shadow:0 8px 22px rgba(20,9,66,.12);backdrop-filter:blur(12px)}
.hub-banner-badge b{color:var(--purple);font-size:.95rem}
.hero{position:relative;overflow:hidden;padding:90px 0 0;background:linear-gradient(180deg,#fbf8ff 0%,#fff 100%)}
.hero-grid{min-height:360px;display:grid;grid-template-columns:1fr;align-items:center;gap:40px;position:relative;z-index:2}
.kicker{display:flex;align-items:center;gap:11px;margin-bottom:22px;color:var(--purple);font-size:.72rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase}
.kicker span{width:8px;height:8px;border-radius:50%;background:linear-gradient(135deg,var(--purple),var(--violet));box-shadow:0 0 0 7px #efe5ff}
.hero-copy{max-width:920px}.hero h1{max-width:900px;color:var(--deep)} .hero h1 em{font-style:normal;color:var(--purple)}
.hero-copy>p{max-width:650px;margin:28px 0 34px;color:var(--muted);font-size:1.04rem}
.actions{display:flex;align-items:center;gap:25px}.hero-link{color:var(--deep);text-decoration:none;font-size:.8rem;font-weight:700}.hero-link span{margin-left:7px}
.hero-visual{position:relative;width:min(100%,500px);aspect-ratio:1.37;justify-self:end;overflow:hidden;border:1px solid rgba(146,47,208,.16);border-radius:28px;background:#f7f2fc;box-shadow:0 28px 70px rgba(94,38,214,.14)}
.hero-visual img{display:block;width:100%;height:100%;object-fit:cover;object-position:center}
.hero-glow{position:absolute;border-radius:50%;filter:blur(4px);pointer-events:none}.glow-one{width:400px;height:400px;right:-120px;top:70px;background:rgba(146,47,208,.08)}.glow-two{width:280px;height:280px;left:-150px;bottom:100px;background:rgba(94,38,214,.06)}
.topic-bar{border-top:1px solid var(--border);border-bottom:1px solid var(--border);background:rgba(255,255,255,.7);position:relative;z-index:3}.topic-inner{min-height:55px;display:flex;justify-content:center;align-items:center;gap:13px;flex-wrap:wrap;color:var(--muted);font-size:.66rem;font-weight:600}.topic-inner i{font-style:normal;color:var(--purple)}
.featured{padding:105px 0 55px}.section-head{display:flex;align-items:end;justify-content:space-between;gap:30px;margin-bottom:30px}.section-head h2{max-width:700px;color:var(--deep)}.section-head>p{max-width:260px;margin:0;color:var(--muted);font-size:.75rem;text-align:right}
.featured-card{display:grid;grid-template-columns:.88fr 1.12fr;min-height:420px;overflow:hidden;border:1px solid var(--border);border-radius:28px;background:white;box-shadow:var(--shadow)}
.featured-art{position:relative;overflow:hidden;padding:30px;display:flex;flex-direction:column;justify-content:space-between;color:white;background:linear-gradient(145deg,var(--deep),var(--violet))}
.featured-art img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center;background:var(--surface-soft)}.featured-art img+span,.featured-art img+strong{position:relative;z-index:2}.featured-art:before{content:'';position:absolute;width:280px;height:280px;right:-100px;top:-90px;border:1px solid rgba(255,255,255,.18);border-radius:50%}.featured-art:after{content:'';position:absolute;width:420px;height:420px;right:-170px;bottom:-220px;border:1px solid rgba(255,255,255,.12);border-radius:50%}
.featured-art span{font-size:.6rem;letter-spacing:.16em;font-weight:700;position:relative;z-index:1}.featured-art strong{font-size:clamp(1.8rem,3vw,3rem);line-height:1.05;letter-spacing:-.04em;position:relative;z-index:1}.art-line{width:110px;height:2px;background:var(--lavender);position:relative;z-index:1}
.featured-content{padding:54px;display:flex;flex-direction:column;justify-content:center}.category{color:var(--purple);font-size:.68rem;font-weight:700;letter-spacing:.1em;text-decoration:none;text-transform:uppercase}.featured-content h3{margin:12px 0 15px;font-size:clamp(1.7rem,3vw,2.5rem);color:var(--deep)}.featured-content>p{max-width:640px;color:var(--muted)}.meta{display:flex;gap:18px;margin:18px 0 28px;color:var(--muted);font-size:.72rem}.read-link{display:inline-flex;align-items:center;gap:8px;width:max-content;color:var(--violet);font-size:.78rem;font-weight:700;text-decoration:none}.read-link span{transition:transform .2s}.read-link:hover span{transform:translateX(4px)}
.themes,.latest{padding:60px 0}.theme-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.theme-card{position:relative;min-height:220px;padding:27px;border:1px solid var(--border);border-radius:20px;background:var(--soft);text-decoration:none;transition:transform .2s,box-shadow .2s}.theme-card:hover{transform:translateY(-4px);box-shadow:0 18px 45px rgba(94,38,214,.09)}.theme-top{display:flex;justify-content:space-between;color:var(--lavender);font-size:.7rem;font-weight:700}.theme-top b{color:var(--purple);font-size:1rem}.theme-icon{margin:23px 0 15px;color:var(--purple);font-size:1.5rem}.theme-card h3{margin:0 0 9px;color:var(--deep)}.theme-card p{margin:0;color:var(--muted);font-size:.82rem}
.latest-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}.latest-card{padding:29px;border:1px solid var(--border);border-radius:20px;background:white}.latest-meta{display:flex;justify-content:space-between;align-items:center;gap:15px}.latest-meta>span{color:var(--muted);font-size:.68rem}.latest-card h3{margin:13px 0 10px;color:var(--deep)}.latest-card p{color:var(--muted);font-size:.84rem;margin-bottom:22px}
.manifesto{margin:55px auto 20px;padding:50px 56px;display:grid;grid-template-columns:100px 1fr;gap:30px;align-items:start;border-radius:28px;background:var(--deep);color:white;overflow:hidden;position:relative}.manifesto:after{content:'';position:absolute;width:420px;height:420px;right:-200px;top:-220px;border:1px solid rgba(255,255,255,.12);border-radius:50%}.manifesto-mark{width:74px;height:74px;display:grid;place-items:center;border:1px solid rgba(255,255,255,.25);border-radius:22px;color:white;font-size:2.8rem;font-weight:300}.manifesto h2{max-width:760px;color:white}.manifesto>div:last-child>p:last-child{max-width:720px;color:#e9deff;font-size:.9rem}
@media(max-width:850px){.hub-banner-card{grid-template-columns:1fr;gap:20px;padding:30px}.hub-banner-visual{min-height:0;aspect-ratio:1.5}.hub-banner-visual img{min-height:0}.hub-banner-copy h2{max-width:720px}.hero-grid{grid-template-columns:1fr;min-height:auto;padding:55px 0 35px}.hero-visual{justify-self:center;width:min(100%,430px)}.featured-card{grid-template-columns:1fr;min-height:0}.featured-art{min-height:290px}.featured-art--image{min-height:0;aspect-ratio:var(--featured-image-ratio,16 / 9)}.theme-grid{grid-template-columns:1fr 1fr}.section-head{align-items:start;flex-direction:column}.section-head>p{text-align:left}.featured-content{padding:35px}}
@media(max-width:560px){.hub-banner{padding-top:12px}.hub-banner-card{gap:18px;padding:24px 19px 19px;border-radius:21px}.hub-banner-copy h2{font-size:1.75rem}.hub-banner-copy>p:not(.hub-banner-kicker){font-size:.82rem;line-height:1.6}.hub-banner-cta{width:100%;justify-content:center}.hub-banner-features{gap:6px;font-size:.6rem}.hub-banner-visual{aspect-ratio:1.2;border-radius:16px}.hub-banner-badge{right:9px;bottom:9px;padding:8px 10px;font-size:.59rem}.hero{padding-top:55px}.actions{align-items:flex-start;flex-direction:column;gap:17px}.hero-visual{margin-top:20px}.topic-inner{justify-content:flex-start;padding:13px 0}.featured,.themes,.latest{padding:70px 0 30px}.theme-grid,.latest-grid{grid-template-columns:1fr}.manifesto{grid-template-columns:1fr;padding:32px 27px}.manifesto-mark{width:60px;height:60px}}
</style>

