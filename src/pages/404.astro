---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Página não encontrada | Terapeuta AI" description="A página que você procura não foi encontrada.">
  <section class="not-found"><div class="container"><p class="eyebrow">404</p><h1>Essa página saiu do caminho.</h1><p>O endereço pode ter mudado ou o conteúdo ainda não foi publicado.</p><a class="btn btn-primary" href="/">Voltar ao início</a></div></section>
</BaseLayout>
<style>.not-found{min-height:58vh;display:grid;place-items:center;text-align:center;padding:80px 0}.not-found p:not(.eyebrow){max-width:560px;margin:20px auto 30px;color:var(--muted)}</style>