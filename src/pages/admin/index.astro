<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Editor — Terapeuta AI</title>
    <link rel="stylesheet" href="https://unpkg.com/decap-cms@beta/dist/decap-cms.css" />
  </head>
  <body>
    <script src="https://unpkg.com/decap-cms@beta/dist/decap-cms.js"></script>
    <script>
      var ArticlePreview = createClass({
        render: function() {
          var entry = this.props.entry;
          var image = entry.getIn(['data', 'image']);
          var imageUrl = image ? this.props.getAsset(image) : null;

          return h('article', {
            style: {
              maxWidth: '820px',
              margin: '0 auto',
              padding: '32px 24px 56px',
              fontFamily: 'Sora, Arial, sans-serif',
              color: '#1b0f83',
              background: '#ffffff'
            }
          },
            h('h1', {
              style: {
                fontSize: '34px',
                lineHeight: '1.15',
                margin: '0 0 14px',
                color: '#1b0f83'
              }
            }, entry.getIn(['data', 'title'])),
            h('p', {
              style: {
                fontSize: '16px',
                lineHeight: '1.6',
                margin: '0 0 20px',
                color: '#5e26d6'
              }
            }, entry.getIn(['data', 'description'])),
            imageUrl
              ? h('img', {
                  src: imageUrl.toString(),
                  alt: entry.getIn(['data', 'imageAlt']) || entry.getIn(['data', 'title']) || '',
                  style: {
                    display: 'block',
                    width: '100%',
                    height: 'auto',
                    borderRadius: '16px',
                    margin: '0 0 28px'
                  }
                })
              : null,
            h('div', {
              style: {
                fontSize: '16px',
                lineHeight: '1.75',
                color: '#222222'
              }
            }, this.props.widgetFor('body'))
          );
        }
      });

      CMS.registerPreviewTemplate('articles', ArticlePreview);
    </script>
  </body>
</html>
