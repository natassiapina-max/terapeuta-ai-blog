---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Inteligência Artificial | Terapeuta AI"
  description="Conteúdos sobre inteligência artificial aplicada à rotina de profissionais da saúde e das terapias."
>
  <section class="container" style="padding:80px 0 48px;">
    <p class="eyebrow">Categoria</p>
    <h1>Inteligência Artificial</h1>
    <p class="muted" style="max-width:720px; font-size:1.08rem;">
      Tecnologia e inteligência artificial aplicadas à rotina de profissionais da saúde e das terapias.
    </p>
  </section>
  <section class="container" style="padding-bottom:80px;">
    <article style="max-width:820px; padding:34px; border:1px solid var(--border); border-radius:22px;">
      <p class="eyebrow">Guia completo</p>
      <h2 style="margin-top:0;">Inteligência Artificial para Terapeutas: Guia Completo</h2>
      <p class="muted">Entenda conceitos, aplicações, limites, privacidade e boas práticas.</p>
      <a class="btn btn-primary" href="/artigos/inteligencia-artificial-para-terapeutas">Ler conteúdo</a>
    </article>
  </section>
</BaseLayout>
