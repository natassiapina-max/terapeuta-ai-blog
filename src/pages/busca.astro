---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const articles = (await getCollection('articles'))
  .filter(article => !article.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const searchIndex = JSON.stringify(articles.map(article => ({
  id: article.id,
  title: article.data.title,
  description: article.data.description,
  category: article.data.category,
  categorySlug: article.data.categorySlug,
  author: article.data.author,
  pubDate: article.data.pubDate.toISOString()
}))).replace(/</g, '\\u003c');
---
<BaseLayout title="Buscar artigos | Blog TerapeutaAI" description="Encontre artigos do Blog TerapeutaAI por tema, prática clínica e gestão." robots="noindex, follow">
  <section class="container search-page">
    <p class="eyebrow">Biblioteca TerapeutaAI</p>
    <h1>Encontre um artigo</h1>
    <p class="intro">Busque por assunto, ferramenta ou necessidade da rotina profissional.</p>
    <form id="page-search" action="/busca/" method="get" role="search">
      <label class="sr-only" for="page-query">Tema ou palavra-chave</label>
      <input id="page-query" name="q" type="search" placeholder="Ex.: prontuário, LGPD, gestão clínica" autocomplete="off" />
      <button class="btn btn-primary" type="submit">Buscar</button>
    </form>
    <p id="result-count" class="result-count" aria-live="polite"></p>
    <div id="results" class="results"></div>
    <p id="empty-state" class="empty-state" hidden>Nenhum artigo encontrado. Tente outra palavra ou <a href="/artigos/">explore todos os artigos</a>.</p>
    <p id="initial-state" class="empty-state" hidden>Digite um tema para encontrar conteúdos relacionados. Você também pode <a href="/artigos/">ver todos os artigos</a>.</p>
  </section>
  <script type="application/json" id="article-search-index" set:html={searchIndex} />
</BaseLayout>
<script>
  const form = document.querySelector('#page-search');
  const input = document.querySelector('#page-query');
  const results = document.querySelector('#results');
  const count = document.querySelector('#result-count');
  const emptyState = document.querySelector('#empty-state');
  const initialState = document.querySelector('#initial-state');
  const dataElement = document.querySelector('#article-search-index');
  const articles = JSON.parse(dataElement?.textContent || '[]');

  const normalize = (value) => value
    .toLocaleLowerCase('pt-BR')
    .normalize('NFD')
    .replace(/[\\u0300-\\u036f]/g, '');

  const renderResults = () => {
    const terms = normalize(input.value).trim().split(/\\s+/).filter(Boolean);
    results.replaceChildren();
    emptyState.hidden = true;
    initialState.hidden = true;

    if (!terms.length) {
      count.textContent = '';
      initialState.hidden = false;
      return;
    }

    const matches = articles
      .map((article) => {
        const title = normalize(article.title);
        const searchable = normalize([article.title, article.description, article.category].join(' '));
        const matchedTerms = terms.filter(term => searchable.includes(term));
        const score = terms.reduce((total, term) => total + (title.includes(term) ? 3 : searchable.includes(term) ? 1 : 0), 0);
        return { article, matchedTerms, score };
      })
      .filter(result => result.matchedTerms.length === terms.length)
      .sort((a, b) => b.score - a.score || new Date(b.article.pubDate) - new Date(a.article.pubDate));

    count.textContent = matches.length === 1 ? '1 artigo encontrado' : `${matches.length} artigos encontrados`;
    emptyState.hidden = matches.length > 0;

    matches.slice(0, 30).forEach(({ article }) => {
      const card = document.createElement('article');
      card.className = 'result-card';

      const category = document.createElement('a');
      category.className = 'eyebrow';
      category.href = `/${article.categorySlug}/`;
      category.textContent = article.category;

      const heading = document.createElement('h2');
      const title = document.createElement('a');
      title.href = `/artigos/${article.id}/`;
      title.textContent = article.title;
      heading.append(title);

      const description = document.createElement('p');
      description.textContent = article.description;

      const meta = document.createElement('small');
      const date = new Date(article.pubDate).toLocaleDateString('pt-BR', { timeZone: 'UTC' });
      meta.textContent = `${article.author} · ${date}`;

      card.append(category, heading, description, meta);
      results.append(card);
    });
  };

  const params = new URLSearchParams(window.location.search);
  input.value = params.get('q') || '';
  form.addEventListener('submit', (event) => {
    event.preventDefault();
    const query = input.value.trim();
    const url = new URL(window.location.href);
    if (query) url.searchParams.set('q', query);
    else url.searchParams.delete('q');
    window.history.replaceState({}, '', url);
    renderResults();
  });
  input.addEventListener('input', renderResults);
  renderResults();
</script>
<style>
.search-page{padding-block:72px;min-height:60vh}.search-page h1{font-size:clamp(2.2rem,5vw,3.6rem)}.intro{max-width:700px;color:var(--muted)}#page-search{display:flex;gap:12px;max-width:760px;margin:28px 0 20px}#page-query{flex:1;min-width:0;min-height:52px;padding:0 17px;border:1px solid var(--border);border-radius:13px;background:#fff;color:var(--deep);font:inherit}#page-search button{border:0;cursor:pointer}.result-count{font-weight:600;color:var(--deep)}.results{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.result-card{padding:22px;border:1px solid var(--border);border-radius:18px;background:#fff}.result-card .eyebrow{font-size:.65rem}.result-card h2{font-size:1.25rem;margin:8px 0}.result-card h2 a{text-decoration:none}.result-card p,.result-card small{color:var(--muted)}.empty-state{padding:20px 0;color:var(--muted)}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}@media(max-width:650px){.search-page{padding-block:44px}.results{grid-template-columns:1fr}#page-search{gap:8px}#page-search button{padding-inline:14px}}
</style>
