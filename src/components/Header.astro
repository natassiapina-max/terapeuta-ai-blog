---
const links = [
  ['IA', '/inteligencia-artificial'],
  ['Gestão Clínica', '/gestao-clinica'],
  ['Prontuário', '/prontuario'],
  ['Marketing', '/marketing'],
  ['Carreira', '/carreira-e-negocios'],
  ['Ética & LGPD', '/etica-e-lgpd']
];
---
<header class="site-header">
  <div class="container header-inner">
    <a href="/" aria-label="Terapeuta AI — início" class="brand">
      <span>TERAPEUTA</span> <strong>AI</strong>
    </a>

    <nav aria-label="Navegação principal">
      {links.map(([label, href]) => (
        <a href={href}>{label}</a>
      ))}
    </nav>

    <a class="btn btn-primary header-cta" href="https://terapeutaai.com.br" target="_blank" rel="noreferrer">
      Conheça o Hub
    </a>
  </div>
</header>

<style>
.site-header {
  position:sticky;
  top:0;
  z-index:50;
  border-bottom:1px solid var(--border);
  background:rgba(255,255,255,.96);
  backdrop-filter:blur(14px);
}
.header-inner {
  min-height:74px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:24px;
}
.brand { text-decoration:none; font-weight:700; font-size:1.05rem; white-space:nowrap; }
.brand span { color:var(--deep); }
.brand strong { color:var(--purple); }
nav { display:flex; align-items:center; gap:20px; font-size:.82rem; }
nav a { color:var(--deep); text-decoration:none; }
nav a:hover { color:var(--purple); }
@media (max-width:1040px) {
  nav { display:none; }
}
@media (max-width:560px) {
  .header-cta { display:none; }
}
</style>
