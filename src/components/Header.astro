---
const links = [
  ['Inteligência Artificial','/inteligencia-artificial'],
  ['Gestão Clínica','/gestao-clinica'],
  ['Prontuário','/prontuario'],
  ['Marketing','/marketing'],
  ['Carreira','/carreira-e-negocios'],
  ['Ética & LGPD','/etica-e-lgpd']
];
---
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="Terapeuta AI — início">
      <img class="brand-logo" src="/images/logomarca-terapeuta-ai-2-.png" width="38" height="38" alt="" /><span>TERAPEUTA</span><strong>AI</strong>
    </a>
    <nav aria-label="Navegação principal">
      {links.map(([label,href]) => <a href={href}>{label}</a>)}
    </nav>
    <a class="btn btn-primary header-cta" href="https://terapeutaai.com.br" target="_blank" rel="noreferrer">Conheça o Hub <span>↗</span></a>
  </div>
</header>
<style>
.site-header{position:sticky;top:0;z-index:50;border-bottom:1px solid rgba(231,218,247,.9);background:rgba(255,255,255,.9);backdrop-filter:blur(18px)}
.header-inner{min-height:76px;display:flex;align-items:center;gap:26px}
.brand{display:inline-flex;align-items:center;gap:7px;margin-right:auto;text-decoration:none;font-size:.92rem;font-weight:700;letter-spacing:-.02em;white-space:nowrap}.brand>span:not(.mark){color:var(--deep)}.brand-logo{display:block;width:38px;height:38px;border-radius:11px;object-fit:cover;flex:0 0 auto}.brand strong{color:var(--purple)}.mark{display:none}
nav{display:flex;align-items:center;gap:21px;font-size:.71rem;font-weight:600}nav a{position:relative;padding:28px 0;color:var(--deep);text-decoration:none;white-space:nowrap}nav a:after{content:'';position:absolute;left:0;right:0;bottom:20px;height:2px;border-radius:9px;background:linear-gradient(90deg,var(--purple),var(--violet));transform:scaleX(0);transition:transform .2s}nav a:hover{color:var(--purple)}nav a:hover:after{transform:scaleX(1)}.header-cta{min-height:42px;padding:0 16px;font-size:.72rem}.header-cta span{margin-left:7px}
@media(max-width:1080px){.header-inner{flex-wrap:wrap;padding:11px 0}.header-cta{margin-left:auto}nav{order:3;width:100%;overflow-x:auto;gap:20px;padding-bottom:2px;scrollbar-width:none}nav::-webkit-scrollbar{display:none}nav a{padding:7px 0 10px}nav a:after{bottom:1px}}
@media(max-width:560px){.header-cta{display:none}.header-inner{min-height:68px}}
</style>