---
const links = [
  ['Inteligência Artificial','/inteligencia-artificial'],
  ['Gestão Clínica','/gestao-clinica'],
  ['Prontuário','/prontuario'],
  ['Marketing','/marketing'],
  ['Carreira','/carreira-e-negocios'],
  ['Ética & LGPD','/etica-e-lgpd']
];
---
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="Terapeuta AI — início">
      <img class="brand-logo" src="/images/logomarca-terapeuta-ai-2-.png" width="38" height="38" alt="" /><span>Terapeuta</span><strong>AI</strong>
    </a>
    <nav aria-label="Navegação principal">
      {links.map(([label,href]) => <a href={href}>{label}</a>)}
    </nav>
    <a class="btn btn-primary header-cta" href="https://terapeutaai.com.br" target="_blank" rel="noreferrer">Conheça o Hub <span>↗</span></a>
    <a class="mobile-header-cta" href="https://terapeutaai.com.br" target="_blank" rel="noreferrer">Conheça o Hub <span>↗</span></a>
  </div>
</header>
<style>
.site-header{position:sticky;top:0;z-index:50;border-bottom:1px solid rgba(231,218,247,.9);background:rgba(255,255,255,.9);backdrop-filter:blur(18px)}
.header-inner{min-height:76px;display:flex;align-items:center;gap:26px}
.brand{display:inline-flex;align-items:center;gap:3px;margin-right:auto;text-decoration:none;font-size:.92rem;font-weight:700;letter-spacing:-.02em;white-space:nowrap}.brand>span:not(.mark){color:var(--deep)}.brand-logo{display:block;width:38px;height:38px;border-radius:11px;object-fit:cover;flex:0 0 auto}.brand strong{color:var(--purple)}.mark{display:none}
nav{display:flex;align-items:center;gap:21px;font-size:.71rem;font-weight:600;min-width:0;max-width:100%}nav a{position:relative;padding:28px 0;color:var(--deep);text-decoration:none;white-space:nowrap}nav a:after{content:'';position:absolute;left:0;right:0;bottom:20px;height:2px;border-radius:9px;background:linear-gradient(90deg,var(--purple),var(--violet));transform:scaleX(0);transition:transform .2s}nav a:hover{color:var(--purple)}nav a:hover:after{transform:scaleX(1)}.header-cta{min-height:42px;padding:0 16px;font-size:.72rem}.header-cta span{margin-left:7px}.mobile-header-cta{display:none}
@media(max-width:1080px){.header-inner{flex-wrap:wrap;padding:11px 0}.header-cta{margin-left:auto}nav{order:3;width:calc(100% - 26px);overflow-x:auto;gap:20px;padding-bottom:2px;scrollbar-width:none}nav::-webkit-scrollbar{display:none}nav a{padding:7px 0 10px}nav a:after{bottom:1px}}
@media(max-width:560px){.site-header{width:100%;max-width:none;box-sizing:border-box;background:#fff}.header-inner{display:grid;grid-template-columns:minmax(0,1fr) auto;grid-template-rows:auto auto;gap:10px 12px;width:100%;max-width:none;min-width:0;min-height:68px;padding:8px 14px;box-sizing:border-box}.header-cta{display:none}nav{grid-column:1 / -1;grid-row:2;order:initial;width:100%;max-width:none;min-width:0;flex:none;overflow-x:auto;gap:20px;padding:0 0 2px;scrollbar-width:none;white-space:nowrap;-webkit-overflow-scrolling:touch;scroll-snap-type:x proximity}nav a{padding:7px 0 10px;flex:0 0 auto;scroll-snap-align:start}.mobile-header-cta{grid-column:2;grid-row:1;display:inline-flex;align-items:center;justify-content:center;position:static;min-height:34px;padding:0 12px;border-radius:10px;background:linear-gradient(135deg,var(--purple),var(--violet));color:#fff;font-size:.67rem;font-weight:700;text-decoration:none;box-shadow:0 6px 16px rgba(94,38,214,.18);z-index:5}.mobile-header-cta span{margin-left:5px}.mobile-header-cta:after{display:none}.mobile-header-cta:hover{color:#fff}.site-header:after{content:'';position:absolute;right:0;bottom:0;width:34px;height:40px;background:linear-gradient(90deg,rgba(255,255,255,0),#fff 82%);pointer-events:none}}
</style>