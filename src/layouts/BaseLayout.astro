---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  type?: 'website' | 'article';
  image?: string;
  publishedTime?: string;
  modifiedTime?: string;
  robots?: string;
}

const {
  title,
  description,
  canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://blog.terapeutaai.com.br').href,
  type = 'website',
  image,
  publishedTime,
  modifiedTime,
  robots = 'index, follow, max-image-preview:large'
} = Astro.props;

const siteUrl = 'https://blog.terapeutaai.com.br';
const ogImage = image ? new URL(image, siteUrl).href : undefined;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#5e26d6" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/images/logomarca-terapeuta-ai-2-.png" />
    <link rel="apple-touch-icon" href="/images/logomarca-terapeuta-ai-2-.png" />
    <link rel="alternate" type="application/rss+xml" title="Blog Terapeuta AI" href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <meta property="og:type" content={type} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Terapeuta AI" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta name="robots" content={robots} />

    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <script is:inline defer src="/clarity-loader.js"></script>

    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-QSDLQTD8WW"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){window.dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-QSDLQTD8WW');
      document.addEventListener('click', function(event) {
        const link = event.target instanceof Element ? event.target.closest('a[href]') : null;
        if (!link) return;
        if (link.dataset.resource) {
          gtag('event', 'resource_download', {
            resource_id: link.dataset.resource,
            page_path: location.pathname,
            transport_type: 'beacon'
          });
        }
        const destination = new URL(link.href, location.href);
        if (destination.hostname === 'terapeutaai.com.br') {
          gtag('event', 'hub_click', {
            link_url: destination.href,
            link_text: link.textContent.trim(),
            page_path: location.pathname,
            transport_type: 'beacon'
          });
        }
      });
    </script>

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'Organization',
          '@id': 'https://terapeutaai.com.br/#organization',
          name: 'Terapeuta AI',
          url: 'https://terapeutaai.com.br',
          logo: 'https://blog.terapeutaai.com.br/images/logomarca-terapeuta-ai-2-.png'
        },
        {
          '@type': 'WebSite',
          '@id': 'https://blog.terapeutaai.com.br/#website',
          url: siteUrl,
          name: 'Blog Terapeuta AI',
          description: 'Conhecimento para quem cuida de pessoas.',
          publisher: { '@id': 'https://terapeutaai.com.br/#organization' },
          inLanguage: 'pt-BR'
        }
      ]
    })} />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <Header />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />
  </body>
</html>

