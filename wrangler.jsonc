{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "terapeuta-ai-blog",
  "compatibility_date": "2026-09-18",
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "LEAD_MAGNETS",
      "bucket_name": "terapeutaai-lead-magnets"
    }
  ],
  "routes": [
    {
      "pattern": "blog.terapeutaai.com.br",
      "custom_domain": true
    }
  ],
  "main": "src/worker.js"
}
